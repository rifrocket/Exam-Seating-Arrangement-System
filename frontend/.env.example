NEXT_PUBLIC_API_URL=http://localhost:8000

# Minimal MVP admin authentication (frontend-only — see lib/auth.ts).
# Never prefix these with NEXT_PUBLIC_: they must stay server-only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# A long random string used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=change-me-too

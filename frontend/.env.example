NEXT_PUBLIC_API_URL=http://localhost:8000

# Minimal MVP admin authentication (frontend-only — see lib/auth.ts).
# Never prefix these with NEXT_PUBLIC_: they must stay server-only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# A long random string used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=change-me-too

# FRONTEND_HOST/FRONTEND_PORT are read by `make start`/`make start-pm2`
# (scripts/*.sh), not by Next.js itself unless the startup command passes
# them explicitly (-H/-p). 0.0.0.0:3000 matches this project's own prior
# default (plain `next dev`, which binds every interface). NEXT_PUBLIC_API_URL
# above is this project's existing "which backend URL does the browser
# call" setting — there's no separate BACKEND_API_URL variable.
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000

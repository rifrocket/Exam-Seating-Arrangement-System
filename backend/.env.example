APP_ENVIRONMENT=development
APP_DATABASE_URL=sqlite:///./data/app.db
APP_SQL_ECHO=false
# Defaults already include both http://localhost:3000 and http://127.0.0.1:3000.
# Override only if the frontend runs on a different host/port, e.g.:
# APP_CORS_ORIGINS=["http://localhost:3001"]

# Protects POST /admin/database/reset (a destructive, full data wipe).
# Set this to the SAME value as the frontend's ADMIN_PASSWORD
# (frontend/.env.local) — one administrator password, not two. Left unset,
# the reset endpoint refuses every request rather than allowing any.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me

# BACKEND_HOST/BACKEND_PORT are read by `make start`/`make start-pm2`
# (scripts/*.sh), not by the FastAPI app itself — uvicorn needs a
# host/port before the app object even exists. `make setup` writes these;
# 127.0.0.1:8000 matches this project's own prior default (plain
# `uvicorn app.main:app`, no --host/--port).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
